.app {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 24px;
    min-height: calc(100vh - 48px);
    font-family: sans-serif;
    color: #f0f0f0;
}

.title {
    margin: 0;
    font-size: 24px;
}

.count {
    font-size: 16px;
}

.increment {
    padding: 8px 16px;
}
