                   "css":  ".wrap { position: relative; width: 300px; height: 160px; background-color: #ffffff; } .row { margin: 0 0 8px 10px; } .g { display: inline-grid; grid-template-columns: 50px 70px; grid-template-rows: 20px 24px; background-color: #e4e4e4; } .g .a { grid-column: 1 / 3; background-color: #d05040; } .g .s { display: grid; grid-column: 1 / 3; grid-template-columns: subgrid; padding: 0 5px; column-gap: 4px; background-color: #c0d0f0; } .g .x { background-color: #40a060; } .g .y { background-color: #f0d890; } .f { display: inline-flex; width: 200px; background-color: #e4e4e4; } .b { display: inline-block; width: 200px; background-color: #e4e4e4; } .c { width: calc(50% + 10px); height: 18px; background-color: #d05040; } .d { flex: 1; height: 18px; background-color: #40a060; }",
