                   "css":  ".wrap { position: relative; width: 340px; height: 300px; background-color: #ffffff; } .g { display: grid; margin: 0 0 6px 10px; background-color: #e4e4e4; grid-auto-rows: 20px; } .k { min-width: 0; } .n .k { min-width: auto; } .big { width: 70px; height: 10px; background-color: #222222; } .small { width: 20px; height: 10px; background-color: #222222; } .c1 { background-color: #f0b0a0; } .c2 { background-color: #a0dcb0; } .c3 { background-color: #a8c0f0; } .f1 { width: fit-content; grid-template-columns: fit-content(30px) 1fr; } .f2 { width: fit-content; grid-template-columns: fit-content(100px) 1fr; } .f3 { width: fit-content; grid-template-columns: fit-content(30px) fit-content(40px); } .f4 { width: fit-content; grid-template-columns: fit-content(30px) 1fr; } .f5 { width: max-content; grid-template-columns: fit-content(30px) auto fit-content(50px); } .f6 { width: fit-content; grid-template-columns: repeat(2, fit-content(25px)) 1fr; } .f7 { width: fit-content; padding: 4px 6px; border: 2px solid #3a4a68; grid-template-columns: fit-content(30px) 1fr; } .f8 { width: 200px; grid-template-columns: fit-content(30px) 1fr; } .fl { display: flex; margin: 0 0 6px 10px; } .fl .g { margin: 0; grid-template-columns: fit-content(30px) 1fr; }",
