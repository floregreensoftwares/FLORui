                   "css":  ".wrap { position: relative; width: 340px; height: 420px; background-color: #ffffff; } .g { display: grid; margin: 0 0 8px 10px; background-color: #e4e4e4; width: 300px; } .c1 { background-color: #d05040; } .c2 { background-color: #40a060; } .c3 { background-color: #4070d0; } .c4 { background-color: #e0b030; } .c5 { background-color: #a050c0; } .g1 { grid-template-areas: \"head head head\" \"nav main main\" \"foot foot foot\"; grid-template-columns: 60px 1fr 1fr; grid-template-rows: 30px 50px 24px; } .g1 .c1 { grid-area: head; } .g1 .c2 { grid-area: nav; } .g1 .c3 { grid-area: main; } .g1 .c4 { grid-area: foot; } .g2 { grid-template-areas: \"a a .\" \". b b\"; grid-template-columns: repeat(3, 80px); grid-template-rows: 40px 40px; gap: 6px; } .g2 .c1 { grid-area: a; } .g2 .c2 { grid-area: b; } .g2 .c3 { grid-column: 3; grid-row: 1; } .g3 { grid-template-columns: [a] 50px [b] 70px [c] 50px [d]; grid-template-rows: [r1] 30px [r2] 30px [r3]; } .g3 .c1 { grid-column: b / d; grid-row: r1 / r2; } .g3 .c2 { grid-column: a / span 2; grid-row: r2 / r3; } .g3 .c3 { grid-column: span 2 / d; grid-row: r2; } .g4 { grid-template-areas: \"head head\" \"side main\"; grid-template-columns: 70px 1fr; grid-template-rows: 28px 56px; } .g4 .c1 { grid-column: head-start / head-end; grid-row: head-start / head-end; } .g4 .c2 { grid-column: side-start / side-end; grid-row: side-start / span 1; } .g4 .c3 { grid-column: main-start / main-end; grid-row: main; } .g5 { grid-template-columns: repeat(2, [x] 40px [y]) 40px; grid-template-rows: 30px 30px; } .g5 .c1 { grid-column: x 2 / y 2; } .g5 .c2 { grid-column: x / span x 2; grid-row: 2; }",
